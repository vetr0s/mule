# Doxygen config for `make docs`. Only non-default settings are listed;
# run `doxygen -x Doxyfile` to see what differs, `doxygen -g` for the rest.

PROJECT_NAME           = MULE
PROJECT_BRIEF          = "Multi-Use Library Essentials"
PROJECT_NUMBER         = $(MULE_DOC_VERSION)
OUTPUT_DIRECTORY       = build/docs

# make docs passes the module folders in dependency order, which is also the
# order the topics appear in and a sensible order to learn them.
INPUT                  = README.md docs $(MULE_DOC_MODULES)
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.h *.c *.md *.dox
RECURSIVE              = YES
EXAMPLE_PATH           = tests notes/str-examples main.c examples/project
LAYOUT_FILE            = docs/DoxygenLayout.xml
HTML_EXTRA_FILES       = notes/str-and-strview.html

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
TYPEDEF_HIDES_STRUCT   = YES
INLINE_SIMPLE_STRUCTS  = YES
SORT_MEMBER_DOCS       = NO

# Link every declaration to its definition, comments included.
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO

# Internal names end in an underscore and stay out of the reference.
EXCLUDE_SYMBOLS        = *_

GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = TOGGLE
GENERATE_LATEX         = NO
QUIET                  = YES

# Hide the MULE_ attribute macros from the rendered signatures.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = MULE_NODISCARD= MULE_UNUSED= \
                         MULE_NORETURN= "MULE_PRINTF(f,a)="

# Every public declaration must be documented, or `make docs` fails.
WARN_AS_ERROR          = FAIL_ON_WARNINGS
HAVE_DOT               = NO   # older doxygen draws graphs by default and needs graphviz
