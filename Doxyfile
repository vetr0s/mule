# Doxygen config for `make docs`. Only non-default settings are listed;
# run `doxygen -x Doxyfile` to see what differs, `doxygen -g` for the rest.

PROJECT_NAME           = MULE
PROJECT_BRIEF          = "Multi-Use Library Essentials"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = src
RECURSIVE              = YES
FILE_PATTERNS          = *.h
EXAMPLE_PATH           = tests
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
GENERATE_LATEX         = NO
QUIET                  = YES

# Hide the MULE_ attribute macros from the rendered signatures.
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = MULE_NODISCARD= MULE_UNUSED= \
                         MULE_NORETURN= "MULE_PRINTF(f,a)="

# Every public declaration must be documented, or `make docs` fails.
WARN_AS_ERROR          = FAIL_ON_WARNINGS
HAVE_DOT               = NO   # older doxygen draws graphs by default and needs graphviz
